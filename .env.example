# Local FastAPI test server only. Use either the single-user pair
# or a JSON array in TEST_USERNAME/TEST_USERS_JSON; never commit real credentials.
TEST_USERNAME=test@example.invalid
TEST_PASSWORD=replace-with-a-test-only-password
# TEST_USERNAME=[{"username":"user1@example.invalid","password":"test-password-1"},{"username":"user2@example.invalid","password":"test-password-2"}]

SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_HOST=127.0.0.1
AUTH_PORT=8000
SESSION_HTTPS_ONLY=false
TRUST_PROXY_HEADERS=false
AUTH_LOG_FILE=auth_test_events.jsonl
